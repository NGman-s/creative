# Required for backend AI calls
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3.5-flash
TEXT_MODEL=qwen3.5-flash
MODEL_TIMEOUT_IMAGE_SEC=90
MODEL_TIMEOUT_TEXT_SEC=60
MODEL_IMAGE_MAX_EDGE=1024

# Optional fallback for Doubao / Ark
# ARK_API_KEY=your_ark_api_key_here
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Backend runtime
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_SIZE_MB=10
THUMBNAIL_RETENTION_DAYS=30
THUMBNAIL_MAX_EDGE=512
THUMBNAIL_QUALITY=70
UPLOAD_STORAGE_LIMIT_MB=3072
